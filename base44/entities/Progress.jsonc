      ]
    },
    "ref_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "episode": {
      "type": "number"
    },
    "position": {
      "type": "number"
    },
    "duration": {
      "type": "number"
    },
    "link": {
      "type": "string"
    }
